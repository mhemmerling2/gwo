{
  "name": "gwo/apps-recruitment-task",
  "type": "project",
  "license": "MIT",
  "description": "GWO Apps Recruitment Task",
  "require": {
    "php": "^8.5",
    "ext-mongodb": "*",
    "mongodb/mongodb": "^2.3",
    "phpdocumentor/reflection-docblock": "^6.0",
    "phpstan/phpdoc-parser": "^2.3",
    "ramsey/uuid": "^4.9",
    "symfony/console": "8.0.*",
    "symfony/dotenv": "^8.0",
    "symfony/flex": "^2",
    "symfony/framework-bundle": "^8.0",
    "symfony/messenger": "8.0.*",
    "symfony/property-access": "8.0.*",
    "symfony/property-info": "8.0.*",
    "symfony/runtime": "8.0.*",
    "symfony/security-bundle": "8.0.*",
    "symfony/serializer": "8.0.*",
    "symfony/yaml": "^8.0"
  },
  "require-dev": {
    "phpstan/phpstan": "^2.1",
    "phpstan/phpstan-strict-rules": "^2.0",
    "phpunit/phpunit": "^12.5",
    "symfony/browser-kit": "^8.0",
    "zenstruck/messenger-test": "^1.14",
    "zoltanka/bypass-readonly": "^0.0.4"
  },
  "config": {
    "optimize-autoloader": true,
    "preferred-install": {
      "*": "dist"
    },
    "sort-packages": true,
    "allow-plugins": {
      "symfony/flex": true,
      "symfony/runtime": true
    }
  },
  "autoload": {
    "psr-4": {
      "Gwo\\AppsRecruitmentTask\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Gwo\\AppsRecruitmentTask\\Tests\\": "tests/"
    },
    "files": [
      "stubs/mongodb-loader.php"
    ]
  },
  "scripts": {
    "auto-scripts": {
      "cache:clear": "symfony-cmd",
      "assets:install %PUBLIC_DIR%": "symfony-cmd"
    },
    "post-install-cmd": [
      "@auto-scripts"
    ],
    "post-update-cmd": [
      "@auto-scripts"
    ]
  },
  "conflict": {
    "symfony/symfony": "*"
  },
  "extra": {
    "symfony": {
      "allow-contrib": false,
      "require": "8.0.*"
    }
  }
}
